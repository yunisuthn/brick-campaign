generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tables and columns follow PostgreSQL snake_case; Prisma fields stay camelCase.
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// One season. Rates live here (not on each entry) so a new season changes them in one place.
// Money is stored as integer Ariary: the currency has no subunit in daily use.
model Campaign {
  id              String    @id @default(uuid(7)) @db.Uuid
  year            Int       @unique
  startedOn       DateTime  @map("started_on") @db.Date
  closedOn        DateTime? @map("closed_on") @db.Date
  mouldingRate    Int       @map("moulding_rate")
  transportRate   Int       @map("transport_rate")
  kilnLoadingRate Int       @map("kiln_loading_rate")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  productions Production[]
  payments    Payment[]
  kilnBatches     KilnBatch[]
  contractorWorks ContractorWork[]

  @@map("campaigns")
}

// Production and pay unit: one person or a household of 2-3. A single person is a moulder of 1 member.
// Reference data, not an entry: a mistaken or departed moulder is deactivated, never deleted.
model Moulder {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  memberCount Int      @default(1) @map("member_count")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  productions Production[]
  payments    Payment[]

  @@map("moulders")
}

/// Land contract: `durable` spans seasons, `seasonal` is signed for one campaign.
enum RiceFieldContract {
  durable
  seasonal
}

// Where the clay is dug. The contract cost is an Expense, not a field here.
// Surface in whole square metres (1 are = 100 m2), optional: not every contract states it.
model RiceField {
  id           String            @id @default(uuid(7)) @db.Uuid
  name         String
  location     String
  surfaceM2    Int?              @map("surface_m2")
  contractType RiceFieldContract @map("contract_type")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  productions Production[]

  @@map("rice_fields")
}

// One day of moulding by one moulder on one rice field. No amount stored: pay is quantity x campaign rate.
// A wrong entry is cancelled (cancelledAt), never deleted: cancelled rows leave the API but keep the history.
model Production {
  id          String    @id @default(uuid(7)) @db.Uuid
  campaignId  String    @map("campaign_id") @db.Uuid
  moulderId   String    @map("moulder_id") @db.Uuid
  riceFieldId String    @map("rice_field_id") @db.Uuid
  date        DateTime  @db.Date
  quantity    Int
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  campaign  Campaign  @relation(fields: [campaignId], references: [id])
  moulder   Moulder   @relation(fields: [moulderId], references: [id])
  riceField RiceField @relation(fields: [riceFieldId], references: [id])

  @@index([campaignId, moulderId])
  @@map("productions")
}

/// Why money went out: weekly food allowance (vatsy), an advance, or the end-of-campaign settlement.
enum PaymentType {
  vatsy
  advance
  settlement
}

// Money paid to a moulder or to a named contractor (transport, kiln loading). Replaces the "paid"
// column of the notebook. Exactly one beneficiary: moulder_id or contractor_name, enforced by a CHECK
// constraint written by hand in the migration (Prisma has no syntax for it). Contractors are matched
// by exact name: a known limit of the v1. A wrong entry is cancelled, never deleted.
model Payment {
  id             String      @id @default(uuid(7)) @db.Uuid
  campaignId     String      @map("campaign_id") @db.Uuid
  moulderId      String?     @map("moulder_id") @db.Uuid
  contractorName String?     @map("contractor_name")
  type           PaymentType
  date           DateTime    @db.Date
  amount         Int
  cancelledAt    DateTime?   @map("cancelled_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])
  moulder  Moulder? @relation(fields: [moulderId], references: [id], onDelete: Restrict)

  @@index([campaignId, moulderId])
  @@index([campaignId, contractorName])
  @@map("payments")
}

// One firing. Moves its quantity from raw stock (when loaded) to fired stock (when unloaded).
// Breakage is not counted: what goes in comes out. A wrong entry is cancelled, never deleted.
model KilnBatch {
  id          String    @id @default(uuid(7)) @db.Uuid
  campaignId  String    @map("campaign_id") @db.Uuid
  loadedOn    DateTime  @map("loaded_on") @db.Date
  unloadedOn  DateTime? @map("unloaded_on") @db.Date
  quantity    Int
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  campaign        Campaign         @relation(fields: [campaignId], references: [id])
  contractorWorks ContractorWork[]

  @@index([campaignId])
  @@map("kiln_batches")
}

/// Paid-per-brick steps done by people other than the moulders.
enum ContractorWorkType {
  transport
  kiln_loading
}

// Bricks carried to the kiln or loaded into it, by a contractor known by a free-text name, for one
// firing. Paid at the campaign rate of the type; what is owed is computed per exact name (known
// limit of the v1). A wrong entry is cancelled, never deleted.
model ContractorWork {
  id             String             @id @default(uuid(7)) @db.Uuid
  campaignId     String             @map("campaign_id") @db.Uuid
  kilnBatchId    String             @map("kiln_batch_id") @db.Uuid
  type           ContractorWorkType
  contractorName String             @map("contractor_name")
  date           DateTime           @db.Date
  quantity       Int
  cancelledAt    DateTime?          @map("cancelled_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  campaign  Campaign  @relation(fields: [campaignId], references: [id])
  kilnBatch KilnBatch @relation(fields: [kilnBatchId], references: [id])

  @@index([campaignId, contractorName])
  @@index([kilnBatchId])
  @@map("contractor_works")
}
