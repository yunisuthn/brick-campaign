# Docker publishes Postgres on 5433 so it never collides with a native PostgreSQL install on 5432.
POSTGRES_USER=brick
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brick_campaign
POSTGRES_PORT=5433
DATABASE_URL=postgresql://brick:change-me@localhost:5433/brick_campaign
# Signs the session cookie. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional: PORT (default 3000; the Vite proxy reads it too), NODE_ENV (development | test | production, default development)
# Optional: WEB_ROOT, the folder of the built front. Set it and the API serves the front too,
# on the same origin (apps/web/dist). Leave it unset in development, where Vite serves it.
# Account creation (no public sign-up): SEED_USER_EMAIL and SEED_USER_PASSWORD (12+ chars),
# then `pnpm --filter api create-user [--reset-password]`
